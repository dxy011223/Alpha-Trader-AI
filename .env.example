# 数据库与缓存
POSTGRES_DB=alpha_trader
POSTGRES_USER=alpha
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://alpha:请替换数据库密码@postgres:5432/alpha_trader
REDIS_URL=redis://redis:6379/0
ENVIRONMENT=production

# 外部服务（行情与新闻 RSS 无需密钥；AI 未配置时明确回退到规则分析）
MARKET_API_KEY=
NEWS_API_KEY=
AI_API_KEY=
AI_MODEL=gpt-5-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=20
# 个人部署唯一访问令牌，生产环境至少 32 位；不要提交真实值
OWNER_API_TOKEN=
AI_REQUESTS_PER_MINUTE=12
AI_REQUESTS_PER_DAY=300
AI_MAX_CONCURRENCY=2
# 用 Fernet.generate_key() 生成；用于加密交易所只读 API 凭证，禁止提交真实值
CREDENTIAL_ENCRYPTION_KEY=
NEWS_REFRESH_SECONDS=300
MARKET_SCAN_INTERVAL_SECONDS=300
MARKET_SCAN_CACHE_SECONDS=360
DAILY_REVIEW_HOUR=0
DAILY_REVIEW_MINUTE=10
MAX_ACTIVE_EXECUTIONS=3
