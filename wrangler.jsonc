{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alpha-trader-ai",
  "main": "./mobile-app/worker/app.js",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SIMULATION_SCHEDULER",
        "class_name": "SimulationScheduler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SimulationScheduler"]
    }
  ],
  "secrets": {
    "required": ["OWNER_API_TOKEN", "DEVICE_SESSION_SECRET", "BACKEND_SIGNING_PRIVATE_KEY"]
  },
  "assets": {
    "directory": "./mobile-app/dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alpha-trader-ai-db",
      "database_id": "ca0e5485-0c5a-4de0-910c-e447f9f45631",
      "migrations_dir": "./mobile-app/migrations"
    }
  ],
  "routes": [
    {
      "pattern": "alpha-trader-ai.lngzunoma.top",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
